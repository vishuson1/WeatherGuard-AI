# WeatherGuard AI Environment Configuration

# Database Configuration (PostgreSQL / PostGIS in Production, SQLite fallback in local dev)
DATABASE_URL=postgresql://weatherguard_user:weatherguard_password@localhost:5432/weatherguard_db
# For SQLite local development:
# DATABASE_URL=sqlite:///./weatherguard.db

# Security & Authentication
SECRET_KEY=weatherguard-super-secret-production-key-change-in-production-2026

# External Meteorological APIs
# Open-Meteo works globally without an API key for live & archive data.
# Set WEATHER_API_KEY if using OpenWeatherMap or custom NWP API:
WEATHER_API_KEY=
NWP_API_URL=https://api.weatherguard.internal/v1/nwp
NWP_API_KEY=

# Operational Configuration
ENVIRONMENT=production
DATA_REFRESH_INTERVAL_MINUTES=15
DEMO_MODE=false

# Configurable Forecast Bust Thresholds
DEFAULT_BUST_THRESHOLD_TEMP_C=3.0
DEFAULT_BUST_THRESHOLD_RAIN_MM=20.0
DEFAULT_BUST_THRESHOLD_WIND_MS=7.0
DEFAULT_BUST_THRESHOLD_PRESSURE_HPA=3.0
